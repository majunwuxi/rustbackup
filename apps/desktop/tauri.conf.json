{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustBackup",
  "version": "0.1.4",
  "identifier": "com.rustbackup.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/stage-agent.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self'"
      },
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "RustBackup",
        "width": 760,
        "height": 560,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/rustbackup-agent"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  }
}
