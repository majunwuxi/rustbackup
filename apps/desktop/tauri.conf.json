{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustBackup",
  "version": "0.1.0",
  "identifier": "com.rustbackup.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self'"
      },
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "RustBackup",
        "width": 760,
        "height": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
